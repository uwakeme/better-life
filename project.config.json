{
  "description": "life-better 生活经验库 · 微信小程序",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "life-better",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "ignoreDevUnusedFiles": true,
    "checkInvalidKey": true
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "server" },
      { "type": "folder", "value": "scripts" },
      { "type": "folder", "value": "docs" },
      { "type": "folder", "value": "design" },
      { "type": "folder", "value": "node_modules" }
    ]
  },
  "condition": {}
}
