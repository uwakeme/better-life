<view class="tk page">
  <nav-bar title="{{categoryName || '领域'}}" />

  <view class="sec-h">
    <view class="sec-h-t">{{categoryName}}</view>
    <view wx:if="{{categoryDesc}}" class="sec-h-s">{{categoryDesc}}</view>
  </view>

  <tag-pills wx:if="{{tags.length}}" items="{{tags}}" value="{{tagId}}" label="按二级标签筛选" bind:change="onTag" />

  <view wx:if="{{source === 'demo' && !loading}}" class="notice">
    当前为演示数据，以下为离线样例。
  </view>

  <view class="filter-bar">
    <text class="filter-now">共 {{total}} 条经验</text>
  </view>

  <state-view wx:if="{{loading}}" type="loading" />
  <view wx:elif="{{error && cards.length}}" class="notice warn">
    <text>{{error}}</text>
    <button class="btn sm" bindtap="retry" hover-class="tap">重试</button>
  </view>
  <state-view
    wx:elif="{{error}}"
    type="error"
    title="网络不太顺畅，没连上"
    text="{{error}}"
    action-text="重新加载"
    bind:action="retry"
  />
  <state-view
    wx:elif="{{!cards.length}}"
    type="empty"
    title="这个领域还没有内容"
    text="换个标签看看，或者去搜索找找别的。"
    action-text="去搜索"
    bind:action="goSearch"
  />
  <view wx:else class="list">
    <experience-card wx:for="{{cards}}" wx:key="id" card="{{item}}" bind:open="openExp" />
  </view>
  <view wx:if="{{loadingMore}}" class="list-status" aria-role="status">正在加载更多…</view>
  <view wx:elif="{{hasMore && !loading && !error}}" class="list-status">
    <button class="btn sm" bindtap="onReachBottom" hover-class="tap">加载更多</button>
  </view>
  <view wx:elif="{{!loading && cards.length}}" class="list-status">已经到底了</view>
</view>
