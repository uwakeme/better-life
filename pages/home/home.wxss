.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.search-ic { width: 34rpx; height: 34rpx; }
.cat-ic { width: 38rpx; height: 38rpx; margin-top: 8rpx; }
.grow { flex: 1; }
.filter-bar .pill {
  background: var(--card);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  box-shadow: var(--sh-sm-rpx) var(--shadow-sm);
}
.filter-bar .pill.on { background: var(--ink); color: #fff; }
.tap { opacity: .78; }
