.page { min-height: 100vh; padding-bottom: 60rpx; }

.inbox { padding: 8rpx var(--pad-rpx) 40rpx; }
.fbitem {
  background: var(--card);
  border-radius: var(--r-blk-rpx);
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--sh-sm-rpx) var(--shadow-sm);
}
.fbitem-h { display: flex; align-items: center; gap: 14rpx; }
.fbitem-k {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  background: var(--s-wheat);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}
.fbitem-s { font-size: 24rpx; color: var(--ink-3); }
.fbitem-s.st-accepted { color: var(--good-ink); }
.fbitem-s.st-replied { color: var(--link-ink); }
.fbitem-s.st-ignored { color: var(--ink-3); }
.fbitem-d { font-size: 23rpx; color: var(--ink-3); }
.fbitem-c {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--ink);
}
.fbitem-m { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-3); }
.fbitem-r {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: var(--paper-2);
}
.fbitem-rl {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-bottom: 6rpx;
}
.fbitem-rv { font-size: 26rpx; line-height: 1.7; color: var(--ink); }
