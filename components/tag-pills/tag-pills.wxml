<view class="pills {{scroll ? 'pills-row' : ''}}">
  <text wx:if="{{label}}" class="pills-label">{{label}}</text>
  <button
    wx:for="{{items}}"
    wx:key="id"
    class="pill {{value === item.id ? 'on' : ''}}"
    data-id="{{item.id}}"
    bindtap="onPick"
    hover-class="tap"
    aria-role="radio"
    aria-checked="{{value === item.id}}"
    aria-label="{{item.name}}{{value === item.id ? '，已选中' : ''}}"
  >{{value === item.id ? '✓ ' : ''}}{{item.name}}</button>
</view>
