.point {
  border-radius: 40rpx;
  padding: 28rpx 28rpx 26rpx;
  box-shadow: var(--sh-rpx) var(--shadow);
  position: relative;
  background: var(--s-cream);
  margin-bottom: 26rpx;
}
.point-h {
  border: none;
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 88rpx;
  background: transparent;
  font-family: var(--sans);
  text-align: left;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.point-h::after, .point-sum::after { border: none; }
.point-n { font-size: 28rpx; color: var(--ink-3); flex: 0 0 auto; }
.point-t {
  flex: 1;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.55;
  color: var(--ink);
}
.point-b { margin-top: 18rpx; }
.point-d {
  font-size: 27rpx;
  line-height: 1.85;
  color: var(--ink-2);
}
.point-a {
  margin-top: 16rpx;
  font-family: var(--hand);
  font-size: 27rpx;
  color: var(--ink-2);
  background: var(--glass);
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
  display: inline-block;
}
.point-sum {
  border: none;
  margin: 16rpx 0 0;
  width: 100%;
  min-height: 72rpx;
  font-family: var(--sans);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background: var(--glass);
  font-size: 25rpx;
  color: var(--ink-2);
}
.point-sum-x { color: var(--ink-3); }
.point-src { margin-top: 18rpx; }
.point-none { margin-top: 18rpx; font-size: 25rpx; color: var(--bad-ink); }
