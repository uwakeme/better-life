<view class="strip {{compact ? 'strip-compact' : ''}}">
  <view wx:if="{{source.badge}}" class="strip-badge">{{source.badge}}</view>
  <view class="strip-t">{{source.title}}</view>
  <view wx:if="{{source.meta}}" class="strip-m">{{source.typeLabel}} · {{source.meta}}</view>
  <view wx:if="{{source.note}}" class="strip-n">为什么信它：{{source.note}}</view>
  <view class="strip-link">
    <image class="chip-img" src="/assets/icons/link.png" />
    <text>{{source.host}}</text>
  </view>
  <view wx:if="{{source.also}}" class="strip-also">同时支撑：{{source.also}}</view>
  <!-- catchtap：不冒泡到外层的 onToggle，
       否则点「复制链接」会把要点折叠起来 -->
  <button class="copy" catchtap="onCopy" hover-class="tap" aria-label="复制依据链接：{{source.title}}">复制链接</button>
</view>
