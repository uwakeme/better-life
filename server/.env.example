# 服务端环境变量样例
# 复制成 .env 后按需修改（.env 不入库）

# ---- 运行环境 ----
NODE_ENV=development
PORT=8080

# ---- 数据库 ----
# 真 PostgreSQL 连接串；留空且 USE_MEMORY_DB=true 时走内存库
DATABASE_URL=
USE_MEMORY_DB=false
PGSSL=false

# ---- 鉴权 ----
# 生产环境必填（assertProductionConfig 会拦住）
TOKEN_SECRET=
TOKEN_TTL_DAYS=7
# 首次部署时把这些 openid 提成管理员，逗号分隔
ADMIN_OPENIDS=

# ---- 微信 ----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_API_BASE=https://api.weixin.qq.com

# ---- 内容安全审核 ----
# real = 走微信 msgSecCheck / mediaCheckAsync；dev-skip = 本地自检直接放行
SECCHECK_MODE=dev-skip
# 配了就必须带对，异步回调会校验这个令牌
MEDIA_CALLBACK_TOKEN=

# ---- embedding ----
# siliconflow（bge-m3/1024 维）/ minimax（embo-01/1536 维）/ local（零依赖哈希，仅自检）
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# ---- 检索 ----
RRF_K=60
VECTOR_TOP_K=30
KEYWORD_TOP_K=30
SEARCH_LIMIT=20

# ---- 限流 ----
RATE_LIMIT_FEEDBACK_PER_DAY=5
RATE_LIMIT_VOTE_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=30